# =========================
# Symfony production defaults
# =========================
APP_ENV=prod
APP_DEBUG=0

# IMPORTANT: change this for production
APP_SECRET=5c3c8b1d9e7a2f4c6b8d0e1f2a3b4c5d

# Default application URI
DEFAULT_URI=http://localhost:8080

# Trust proxy headers if you're behind a load balancer / reverse proxy
TRUSTED_PROXIES=10.0.0.0/8
TRUSTED_HOSTS=^.*$

# =========================
# Database
# =========================
# Used by Doctrine via DATABASE_URL
# For local docker compose, hostname should be "db"
DATABASE_URL=mysql://app:app@db:3306/app?serverVersion=8.0&charset=utf8mb4

# =========================
# Doctrine migrations
# =========================
# Set to 1 to auto-run migrations on container start
RUN_MIGRATIONS=1

